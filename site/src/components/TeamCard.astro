---
interface Props {
  name: string;
  title: string;
  photo?: string;
  linkedin?: string;
}

const { name, title, photo = "https://via.placeholder.com/120", linkedin = "#" } = Astro.props;
---

<div class="team-card">
  <div class="team-avatar">
    <img src={photo} alt={`${name} photo`} />
  </div>
  <div class="team-info">
    <h3 class="team-name">{name}</h3>
    <p class="team-title">{title}</p>
    <a class="team-linkedin" href={linkedin} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      Connect on LinkedIn
    </a>
  </div>
</div>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .team-card:hover {
    transform: translateY(-3px);
    border-color: var(--sl-color-accent);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15);
  }

  .team-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--sl-color-accent);
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  .team-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .team-name {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--sl-color-white);
    font-family: var(--font-display, system-ui);
    letter-spacing: -0.02em;
  }

  .team-title {
    margin: 0;
    font-size: 0.82rem;
    color: var(--sl-color-gray-2);
    line-height: 1.4;
  }

  .team-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.76rem;
    font-weight: 600;
    color: #f0f6fc;
    background: #0a66c2;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .team-linkedin:hover {
    background: #004182;
    transform: translateY(-1px);
    color: #f0f6fc;
  }

  .team-linkedin svg {
    flex-shrink: 0;
  }
</style>
